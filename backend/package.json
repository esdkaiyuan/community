{
  "name": "community-backend",
  "version": "0.0.1",
  "description": "共创社区平台后端服务",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "uploads:prune": "node scripts/prune-uploads.js --apply",
    "uploads:prune:dry": "node scripts/prune-uploads.js",
    "logs:prune": "node scripts/prune-activity-logs.js --apply",
    "logs:prune:dry": "node scripts/prune-activity-logs.js",
    "logs:check": "node scripts/check-log-sanitize.js",
    "format": "prettier --write server.js src"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.4.0",
    "mysql2": "^3.9.0",
    "sequelize": "^6.37.0"
  },
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.9.9"
  }
}
