# 生产环境配置示例
# 复制此文件为 .env 并修改相应的值

# 服务器配置
PORT=5000
NODE_ENV=production

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# JWT配置（请修改为随机字符串）
JWT_SECRET=your_random_secret_key_here
JWT_EXPIRES_IN=7d

# 统一身份认证服务（邮箱验证码 / 密码登录 / 密码重置）
# API Key 需由服务管理端创建，只授予 auth、verify 权限；不要提交到仓库
EMAIL_VERIFY_BASE_URL=https://email.esdkaiyuan.online/api/v1
EMAIL_VERIFY_API_KEY=sk-your_email_service_key_here
EMAIL_VERIFY_TIMEOUT_MS=10000

# CORS配置（可选）
CORS_ORIGIN=http://your-domain.com
